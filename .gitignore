# Local-only infra and tooling configs
docker-compose.yml
# Slither config + its local triage database (slither.db.json) are a local pair;
# committing the config without the triage db turns the CI gate red on the
# intentionally-vulnerable benchmark fixtures.
slither.config.json
# foundry.toml must stay local: committing it makes the Slither CI action detect
# a Foundry project and compile+scan the intentionally-vulnerable benchmark
# fixtures, turning the security gate red. Kept local like the Slither triage db.
foundry.toml

