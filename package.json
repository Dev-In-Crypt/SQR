{
  "name": "solidity-quick-review",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "worker": "tsx scripts/worker.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:contract": "forge test -vvv",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "test:integration:redis": "tsx scripts/run-integration-tests.ts --redis",
    "test:e2e": "tsx scripts/run-e2e-tests.ts",
    "test:e2e:headed": "tsx scripts/run-e2e-tests.ts --headed",
    "test:all": "npm run test:unit && npm run test:contract && npm run test:integration && npm run test:e2e",
    "playwright:install": "playwright install --with-deps chromium",
    "security:slither": "slither . --config-file slither.config.json --json-types detectors",
    "security:slither:ci": "slither . --config-file slither.config.json --json-types detectors",
    "security:slither:triage": "slither . --config-file slither.config.json --json-types detectors --triage-mode",
    "check:db": "tsx scripts/check-db.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bullmq": "^5.12.0",
    "ioredis": "^5.4.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
