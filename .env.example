# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local
NODE_ENV=development

# Data
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solidity_quick_review?schema=public
REDIS_URL=redis://localhost:6379

# Chain
BASE_CHAIN_ID=8453
STAGING_BASE_CHAIN_ID=84532
BASE_RPC_URL=
BASE_MAINNET_RPC_URL=
BASE_SEPOLIA_RPC_URL=
# Deploy ReceiptRegistry v0.2.0+ and set its address here (legacy registries are deprecated)
RECEIPT_CONTRACT_ADDRESS=

# Source fetch
BASESCAN_API_URL=https://api.etherscan.io/v2/api
BASESCAN_API_KEY=
SOURCIFY_API_URL=https://repo.sourcify.dev/contracts/full_match

# Analysis
ANALYZER_VERSION=0.1.0
RULESET_VERSION=0.1.0
ENABLE_SLITHER=true
SOLC_PATH=C:\solc\solc.exe

# LLM
# OpenAI default: OPENAI_BASE_URL=https://api.openai.com/v1
# OpenRouter example: OPENAI_BASE_URL=https://openrouter.ai/api/v1 and model like openai/gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_HTTP_REFERER=http://localhost:3000
OPENAI_APP_NAME=Solidity Quick Review
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0

# Security
SESSION_COOKIE_NAME=sqr_session
SESSION_DAYS=30
PRIVATE_LINK_SECRET=replace_with_32+_bytes
