# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=local
NODE_ENV=development

# Data
# Runtime connection (pooled if your provider supports it)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solidity_quick_review?schema=public
# Direct/unpooled connection for Prisma schema operations (db push/migrate)
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/solidity_quick_review?schema=public
REDIS_URL=redis://localhost:6379
# Optional BullMQ queue name (use a unique value per environment to avoid cross-env worker collisions)
ANALYSIS_QUEUE_NAME=analysis-jobs

# Chain
BASE_CHAIN_ID=8453
STAGING_BASE_CHAIN_ID=84532
BASE_RPC_URL=
BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=
# Deploy ReceiptRegistry v0.2.0+ and set its address here (legacy registries are deprecated)
RECEIPT_CONTRACT_ADDRESS=0x15e2D6a335aBBa7374ebeBa5EBD994346E2de35B

# Trusted client IP extraction
# Ordered header list, checked left to right. x-forwarded-for is parsed with TRUST_PROXY_HOPS.
TRUSTED_IP_HEADERS=cf-connecting-ip,x-real-ip,x-vercel-forwarded-for,x-forwarded-for
# Number of trusted proxy hops on the right side of x-forwarded-for.
TRUST_PROXY_HOPS=1

# Source fetch
BASESCAN_API_URL=https://api.etherscan.io/v2/api
BASESCAN_API_KEY=
SOURCIFY_API_URL=https://repo.sourcify.dev/contracts/full_match
SOURCE_FETCH_TIMEOUT_MS=12000

# Analysis
ANALYZER_VERSION=0.1.0
RULESET_VERSION=0.1.0
ANALYSIS_TOTAL_TIMEOUT_MS=180000
STRUCTURE_EXTRACTION_TIMEOUT_MS=20000
REPORT_GENERATION_TIMEOUT_MS=60000
ANALYSIS_STALE_TIMEOUT_MS=240000
ANALYSIS_STALE_SWEEP_INTERVAL_MS=60000
SCANNER_TIMEOUT_MS=90000
ENABLE_SLITHER=true
SOLC_PATH=C:\solc\solc.exe
ENABLE_SOLC_AUTO_RESOLVE=true
SOLC_VERSION_MANAGER=solc-select
SOLC_FALLBACK_PATH=
SOLC_CACHE_DIR=
ENABLE_STRUCTURED_AUDIT_CONTEXT=true

# LLM
# OpenAI default: OPENAI_BASE_URL=https://api.openai.com/v1
# OpenRouter example: OPENAI_BASE_URL=https://openrouter.ai/api/v1 and model like openai/gpt-4.1-mini
# OPENAI_GENERAL_MODEL is used for summaries/formatting/explanations
# OPENAI_AUDIT_MODEL is used for AI contract audit (fallbacks to OPENAI_GENERAL_MODEL if empty)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_HTTP_REFERER=http://localhost:3000
OPENAI_APP_NAME=Solidity Quick Review
OPENAI_GENERAL_MODEL=gpt-4.1-mini
OPENAI_AUDIT_MODEL=gpt-4.1
OPENAI_TEMPERATURE=0
OPENAI_EXEC_SUMMARY_TIMEOUT_MS=20000
OPENAI_AUDIT_TIMEOUT_MS=45000

# Rate limits (analyses per UTC day)
RATE_LIMIT_ANON_PER_DAY=3
RATE_LIMIT_WALLET_PER_DAY=10
RATE_LIMIT_AUTH_IP_PER_DAY=10
# Public no-auth lookups (e.g. /verify receipt checks) per IP per UTC day
RATE_LIMIT_PUBLIC_LOOKUP_PER_DAY=120
# Successful reports for identical input are reused within this window instead of re-running the pipeline
ANALYSIS_REUSE_WINDOW_MINUTES=1440

# Security
SESSION_COOKIE_NAME=sqr_session
SESSION_DAYS=30
PRIVATE_LINK_SECRET=replace_with_32+_bytes
