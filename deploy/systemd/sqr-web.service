[Unit]
Description=Solidity Quick Review Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sqr
Group=sqr
WorkingDirectory=/opt/sqr/app
EnvironmentFile=/etc/sqr/sqr.env
ExecStart=/usr/bin/env npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
