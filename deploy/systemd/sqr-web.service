[Unit]
Description=Solidity Quick Review Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deployer
Group=deployer
WorkingDirectory=/var/www/solidityquickreview
EnvironmentFile=/etc/sqr/sqr.env
ExecStart=/usr/local/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
