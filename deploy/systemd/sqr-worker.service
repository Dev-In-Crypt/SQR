[Unit]
Description=Solidity Quick Review Worker
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=sqr
Group=sqr
WorkingDirectory=/opt/sqr/app
EnvironmentFile=/etc/sqr/sqr.env
ExecStart=/usr/bin/env npm run worker
Restart=always
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
